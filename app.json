{
  "expo": {
    "name": "mKryzys",
    "slug": "mKryzys",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.anonymous.my-app"
    },
    "android": {
      "package": "com.anonymous.myapp",
      "adaptiveIcon": {
        "backgroundColor": "#CD1F1F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0",
            "enableSceneSupport": true
          },
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      [
        "expo-asset",
        {
          "assets": [
            "assets/offline/rag/knowledge_pl.db"
          ]
        }
      ],
      "@maplibre/maplibre-react-native",
      "@bacons/apple-targets",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Zezwól na mikrofon, aby podyktować pytanie asystentowi bezpieczeństwa.",
          "speechRecognitionPermission": "Zezwól na rozpoznawanie mowy, aby zamienić podyktowane pytanie na tekst."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b8a01acb-831d-48f4-b41f-c01d63607bf5"
      }
    },
    "owner": "mehalatii"
  }
}
